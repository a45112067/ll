rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // المجموعات الثابتة: قراءة عامة، كتابة للأدمن فقط
    match /site/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /projects/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /certificates/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /about/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /contact/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /skills/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /experience/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /education/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /languages/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }

    // المنشورات: المنشور فقط متاح للعموم، والباقي للأدمن
    match /posts/{post} {
      allow read: if resource == null || resource.data.status == 'published' || signedIn();
      allow create, update, delete: if signedIn();
    }
  }
}