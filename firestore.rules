rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // إعدادات الموقع: قراءة عامة، كتابة للأدمن فقط
    match /site/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }

    // المنشورات: المنشور فقط متاح للعموم، والباقي للأدمن
    match /posts/{post} {
      allow read: if resource == null || resource.data.status == 'published' || signedIn();
      allow create, update, delete: if signedIn();
    }

    // المشاريع: قراءة عامة، كتابة للأدمن
    match /projects/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }

    // الشهادات: قراءة عامة، كتابة للأدمن
    match /certificates/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}